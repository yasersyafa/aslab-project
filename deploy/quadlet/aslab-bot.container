[Unit]
Description=aslab telegram bot

[Container]
Image=localhost/aslab-bot:master
EnvironmentFile=%h/.config/containers/systemd/aslab-bot.env

HealthCmd=bash -c 'test -f /tmp/bot_heartbeat && [ $(( $(date +%s) - $(stat -c %%Y /tmp/bot_heartbeat) )) -lt 180 ]'
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=90s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
